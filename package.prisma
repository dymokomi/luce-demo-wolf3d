#prisma 4.0
def package "luce-demo-wolf3d" {
    str owner = "dymokomi"
    str version = "0.1.1"
    str kind = "application"
    str language = "luce-base"
    str description = "A Luce Base rewrite of id Software's open-sourced Wolfenstein 3D (1992), presented through luce-ui. It loads the original shareware data files — the same VSWAP, GAMEMAPS and MAPHEAD the DOS exe used — and follows the original modules:"
    str readme = "README.md"
    str entry = "src/main.lucb"

    def application "bundle" {
        str name = "Wolf3D"
        str identifier = "com.luciaos.wolf3d"
    }

    def dependency "luce-ui" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-ui"
    }

    def dependency "luce-audio" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-audio"
    }
}

## tilemap[x][y] as in WL_GAME.C / AsmRefresh (x major).
pub func cell(x: i64, y: i64) -> usize:
    return (usize)(x * map_size + y)

## mapsegs plane order: y * width + x (MAPSPOT).
pub func plane_cell(x: i64, y: i64) -> usize:
    return (usize)(y * map_size + x)

pub func u16le(data: const u8[], offset: usize) -> u16:
    return (u16)data[offset] + (u16)data[offset + 1] * 256

pub func u32le(data: const u8[], offset: usize) -> u32:
    return (u32)u16le(data, offset) + (u32)u16le(data, offset + 2) * 65536

pub func i32le(data: const u8[], offset: usize) -> i32:
    return (i32)u32le(data, offset)

## Wolf4SDL wl_utils.c FixedMul
pub func fixed_mul(a: i64, b: i64) -> i64:
    return (a * b + 0x8000) >> 16

## WL_ACT2.C T_Stand
func t_stand(game: Game*, actor: Actor*):
    sight_player(game, actor)

## WL_STATE.C SightPlayer (kept next to the states it jumps into)
func sight_player(game: Game*, actor: Actor*):
    if (actor.flags & wl_def.fl_attackmode) != 0:
        return
    if actor.temp2 > 0:
        actor.temp2 -= game.tics
        if actor.temp2 > 0:
            return
        actor.temp2 = 0
        first_sighting(game, actor)
        return
    if (actor.flags & wl_def.fl_ambush) != 0:
        if not wl_state.check_sight(game, actor):
            return
    elif not wl_state.check_sight(game, actor) and not game.madenoise:
        return
    if actor.class == wl_def.class_guard:
        actor.temp2 = 1 + wl_types.us_rnd_t(game) // 4
    elif actor.class == wl_def.class_dog:
        actor.temp2 = 1 + wl_types.us_rnd_t(game) // 8
    else:
        actor.temp2 = 1 + wl_types.us_rnd_t(game) // 6

func sight_player_now(game: Game*, actor: Actor*) -> bool:
    if (actor.flags & wl_def.fl_attackmode) != 0:
        return true
    if wl_state.check_sight(game, actor) or game.madenoise:
        first_sighting(game, actor)
        return true
    return false

## WL_STATE.C FirstSighting
func first_sighting(game: Game*, actor: Actor*):
    if actor.class == wl_def.class_guard:
        wl_types.play_sound(game, wl_def.snd_halt)
        wl_state.new_state(actor, &s_grdchase1)
        actor.speed = actor.speed * 3
    elif actor.class == wl_def.class_officer:
        wl_types.play_sound(game, wl_def.snd_nein)
        wl_state.new_state(actor, &s_ofcchase1)
        actor.speed = actor.speed * 5
    elif actor.class == wl_def.class_ss:
        wl_types.play_sound(game, wl_def.snd_ss)
        wl_state.new_state(actor, &s_sschase1)
        actor.speed = actor.speed * 4
    elif actor.class == wl_def.class_dog:
        wl_types.play_sound(game, wl_def.snd_dog_bark)
        wl_state.new_state(actor, &s_dogchase1)
        actor.speed = actor.speed * 2
    elif actor.class == wl_def.class_mutant:
        wl_state.new_state(actor, &s_mutchase1)
        actor.speed = actor.speed * 3
    elif actor.class == wl_def.class_hans:
        wl_types.play_sound(game, wl_def.snd_gutentag)
        wl_state.new_state(actor, &s_bosschase1)
        actor.speed = wl_def.spd_patrol * 3
    actor.flags = actor.flags | wl_def.fl_attackmode | wl_def.fl_firstattack
    if actor.distance < 0:
        actor.distance = 0

## WL_ACT2.C T_Chase
func t_chase(game: Game*, actor: Actor*):
    var dodge = false
    if wl_state.check_line(game, actor.x, actor.y):
        actor.hidden = false
        var dx = actor.tilex - game.player.tilex
        if dx < 0:
            dx = 0 - dx
        var dy = actor.tiley - game.player.tiley
        if dy < 0:
            dy = 0 - dy
        let dist = dx if dx > dy else dy
        var chance = 300
        if dist != 0 and not (dist == 1 and actor.distance < 0x4000):
            chance = (game.tics << 4) // dist
        if wl_types.us_rnd_t(game) < chance:
            if actor.class == wl_def.class_guard:
                wl_state.new_state(actor, &s_grdshoot1)
            elif actor.class == wl_def.class_officer:
                wl_state.new_state(actor, &s_ofcshoot1)
            elif actor.class == wl_def.class_ss:
                wl_state.new_state(actor, &s_ssshoot1)
            elif actor.class == wl_def.class_mutant:
                wl_state.new_state(actor, &s_mutshoot1)
            elif actor.class == wl_def.class_hans:
                wl_state.new_state(actor, &s_bossshoot1)
            return
        dodge = true
    else:
        actor.hidden = true
    if actor.dir == wl_def.nodir:
        if dodge:
            wl_state.select_dodge_dir(game, actor)
        else:
            wl_state.select_chase_dir(game, actor)
        if actor.dir == wl_def.nodir:
            return
    var move = actor.speed * game.tics
    var steps: i64 = 0
    while move > 0 and steps < 64:
        steps += 1
        if actor.distance < 0:
            let door = 0 - actor.distance - 1
            wl_act1.open_door(game, door)
            if game.doors[(usize)door].action != wl_def.dr_open:
                return
            actor.distance = wl_def.tile_global
        if move < actor.distance:
            wl_state.move_obj(game, actor, move)
            break
        actor.x = (actor.tilex << wl_def.tile_shift) + wl_def.tile_global // 2
        actor.y = (actor.tiley << wl_def.tile_shift) + wl_def.tile_global // 2
        move -= actor.distance
        if dodge:
            wl_state.select_dodge_dir(game, actor)
        else:
            wl_state.select_chase_dir(game, actor)
        if actor.dir == wl_def.nodir:
            return

## WL_ACT2.C T_Path
func t_path(game: Game*, actor: Actor*):
    if sight_player_now(game, actor):
        return
    if actor.dir == wl_def.nodir:
        wl_state.select_path_dir(game, actor)
        if actor.dir == wl_def.nodir:
            return
    var move = actor.speed * game.tics
    var steps: i64 = 0
    while move > 0 and steps < 64:
        steps += 1
        if actor.distance < 0:
            let door = 0 - actor.distance - 1
            wl_act1.open_door(game, door)
            if game.doors[(usize)door].action != wl_def.dr_open:
                return
            actor.distance = wl_def.tile_global
        if move < actor.distance:
            wl_state.move_obj(game, actor, move)
            break
        actor.x = (actor.tilex << wl_def.tile_shift) + wl_def.tile_global // 2
        actor.y = (actor.tiley << wl_def.tile_shift) + wl_def.tile_global // 2
        move -= actor.distance
        wl_state.select_path_dir(game, actor)
        if actor.dir == wl_def.nodir:
            return

## WL_ACT2.C T_DogChase
func t_dog_chase(game: Game*, actor: Actor*):
    var dx = actor.x - game.player.x
    if dx < 0:
        dx = 0 - dx
    var dy = actor.y - game.player.y
    if dy < 0:
        dy = 0 - dy
    if dx <= wl_def.min_actor_dist and dy <= wl_def.min_actor_dist:
        wl_state.new_state(actor, &s_dogjump1)
        return
    t_chase(game, actor)

## WL_ACT2.C T_Shoot
func t_shoot(game: Game*, actor: Actor*):
    if not wl_state.check_line(game, actor.x, actor.y):
        if actor.class == wl_def.class_ss:
            wl_types.play_sound(game, wl_def.snd_ss_fire)
        elif actor.class == wl_def.class_hans:
            wl_types.play_sound(game, wl_def.snd_boss_fire)
        else:
            wl_types.play_sound(game, wl_def.snd_nazi_fire)
        return
    var dx = actor.tilex - game.player.tilex
    if dx < 0:
        dx = 0 - dx
    var dy = actor.tiley - game.player.tiley
    if dy < 0:
        dy = 0 - dy
    var dist = dx if dx > dy else dy
    if actor.class == wl_def.class_ss or actor.class == wl_def.class_hans or actor.class == wl_def.class_mutant:
        dist = dist * 2 // 3
    var hitchance = 256 - dist * 16
    if (actor.flags & wl_def.fl_visable) == 0:
        hitchance = 256 - dist * 8
    if actor.class == wl_def.class_ss:
        wl_types.play_sound(game, wl_def.snd_ss_fire)
    elif actor.class == wl_def.class_hans:
        wl_types.play_sound(game, wl_def.snd_boss_fire)
    else:
        wl_types.play_sound(game, wl_def.snd_nazi_fire)
    if wl_types.us_rnd_t(game) < hitchance:
        var damage = wl_types.us_rnd_t(game) >> 4
        if dist < 2:
            damage = wl_types.us_rnd_t(game) >> 2
        elif dist < 4:
            damage = wl_types.us_rnd_t(game) >> 3
        wl_types.take_damage(game, damage)

## WL_ACT2.C T_Bite
func t_bite(game: Game*, actor: Actor*):
    wl_types.play_sound(game, wl_def.snd_dog_attack)
    var dx = game.player.x - actor.x
    if dx < 0:
        dx = 0 - dx
    dx -= wl_def.tile_global
    if dx <= wl_def.min_actor_dist:
        var dy = game.player.y - actor.y
        if dy < 0:
            dy = 0 - dy
        dy -= wl_def.tile_global
        if dy <= wl_def.min_actor_dist:
            wl_types.take_damage(game, wl_types.us_rnd_t(game) >> 4)

## WL_ACT2.C A_DeathScream
func a_death_scream(game: Game*, actor: Actor*):
    if actor.class == wl_def.class_guard:
        wl_types.play_sound(game, wl_def.snd_death1 if wl_types.us_rnd_t(game) & 1 == 0 else wl_def.snd_death2)
    elif actor.class == wl_def.class_officer:
        wl_types.play_sound(game, wl_def.snd_nein)
    elif actor.class == wl_def.class_ss:
        wl_types.play_sound(game, wl_def.snd_lebens)
    elif actor.class == wl_def.class_dog:
        wl_types.play_sound(game, wl_def.snd_dog_death)
    elif actor.class == wl_def.class_mutant:
        wl_types.play_sound(game, wl_def.snd_slurpie)
    elif actor.class == wl_def.class_hans:
        wl_types.play_sound(game, wl_def.snd_mutti)

## WL_STATE.C DamageActor / KillActor — sit with the states they NewState into.
pub func damage_actor(game: Game*, index: i64, damage: i64):
    let actor = &game.actors[(usize)index]
    var dmg = damage
    game.madenoise = true
    if (actor.flags & wl_def.fl_attackmode) == 0:
        dmg = dmg << 1
    actor.health -= dmg
    if actor.health <= 0:
        kill_actor(game, index)
        return
    if (actor.flags & wl_def.fl_attackmode) == 0:
        first_sighting(game, actor)
    if actor.class == wl_def.class_guard:
        wl_state.new_state(actor, &s_grdpain if (actor.health & 1) != 0 else &s_grdpain1)
    elif actor.class == wl_def.class_officer:
        wl_state.new_state(actor, &s_ofcpain if (actor.health & 1) != 0 else &s_ofcpain1)
    elif actor.class == wl_def.class_ss:
        wl_state.new_state(actor, &s_sspain if (actor.health & 1) != 0 else &s_sspain1)
    elif actor.class == wl_def.class_mutant:
        wl_state.new_state(actor, &s_mutpain if (actor.health & 1) != 0 else &s_mutpain1)

pub func kill_actor(game: Game*, index: i64):
    let actor = &game.actors[(usize)index]
    let tilex = actor.x >> wl_def.tile_shift
    let tiley = actor.y >> wl_def.tile_shift
    actor.tilex = tilex
    actor.tiley = tiley
    if actor.class == wl_def.class_guard:
        game.score += 100
        wl_state.new_state(actor, &s_grddie1)
        wl_act1.place_item(game, tilex, tiley, wl_def.bo_clip2)
    elif actor.class == wl_def.class_officer:
        game.score += 400
        wl_state.new_state(actor, &s_ofcdie1)
        wl_act1.place_item(game, tilex, tiley, wl_def.bo_clip2)
    elif actor.class == wl_def.class_ss:
        game.score += 500
        wl_state.new_state(actor, &s_ssdie1)
        if game.bestweapon < wl_def.wp_machinegun:
            wl_act1.place_item(game, tilex, tiley, wl_def.bo_machinegun)
        else:
            wl_act1.place_item(game, tilex, tiley, wl_def.bo_clip2)
    elif actor.class == wl_def.class_dog:
        game.score += 200
        wl_state.new_state(actor, &s_dogdie1)
    elif actor.class == wl_def.class_mutant:
        game.score += 700
        wl_state.new_state(actor, &s_mutdie1)
        wl_act1.place_item(game, tilex, tiley, wl_def.bo_clip2)
    elif actor.class == wl_def.class_hans:
        game.score += 5000
        wl_state.new_state(actor, &s_bossdie1)
        wl_act1.place_item(game, tilex, tiley, wl_def.bo_key1)
    actor.health = 0
    actor.flags = (actor.flags & ~wl_def.fl_shootable) | wl_def.fl_nonmark
    game.killcount += 1
    game.actorat[wl_def.cell(actor.tilex, actor.tiley)] = 0

## WL_ACT2.C starthitpoints[difficulty]
func hitpoints(game: Game*, class: u8) -> i64:
    let d = game.difficulty
    if class == wl_def.class_guard:
        return 25
    if class == wl_def.class_officer:
        return 50
    if class == wl_def.class_ss:
        return 100
    if class == wl_def.class_dog:
        return 1
    if class == wl_def.class_mutant:
        if d <= 0:
            return 45
        if d >= 3:
            return 65
        return 55
    if class == wl_def.class_hans:
        if d <= 0:
            return 850
        if d == 1:
            return 950
        if d == 2:
            return 1050
        return 1200
    return 25

func stand_state(class: u8) -> State*:
    if class == wl_def.class_officer:
        return &s_ofcstand
    if class == wl_def.class_ss:
        return &s_ssstand
    if class == wl_def.class_dog:
        return &s_dogstand
    if class == wl_def.class_mutant:
        return &s_mutstand
    if class == wl_def.class_hans:
        return &s_bossstand
    return &s_grdstand

func path_state(class: u8) -> State*:
    if class == wl_def.class_officer:
        return &s_ofcpath1
    if class == wl_def.class_ss:
        return &s_sspath1
    if class == wl_def.class_dog:
        return &s_dogpath1
    if class == wl_def.class_mutant:
        return &s_mutpath1
    return &s_grdpath1

## WL_ACT2.C SpawnStand / SpawnPatrol / SpawnBoss / SpawnDeadGuard
pub func spawn_enemy(game: Game*, class: u8, x: i64, y: i64, dir: i64, path: bool):
    if game.actor_count >= wl_def.max_actors:
        return
    var speed = wl_def.spd_dog if class == wl_def.class_dog else wl_def.spd_patrol
    var st = path_state(class) if path else stand_state(class)
    var flags = wl_def.fl_shootable
    if class == wl_def.class_hans:
        flags = flags | wl_def.fl_ambush
    if game.maps.walls[wl_def.plane_cell(x, y)] == wl_def.ambush_tile:
        flags = flags | wl_def.fl_ambush
        game.tilemap[wl_def.cell(x, y)] = 0
    var actor = Actor(x = (x << wl_def.tile_shift) + wl_def.tile_global // 2,
        y = (y << wl_def.tile_shift) + wl_def.tile_global // 2,
        tilex = x, tiley = y, angle = dir * 90, class = class, health = hitpoints(game, class),
        shapenum = st.shapenum, flags = flags, active = true, dir = dir * 2,
        speed = speed, distance = wl_def.tile_global, state = st)
    wl_state.new_state(&actor, st)
    if path:
        game.actorat[wl_def.cell(x, y)] = 0
        if dir == 0:
            actor.tilex += 1
        elif dir == 1:
            actor.tiley -= 1
        elif dir == 2:
            actor.tilex -= 1
        else:
            actor.tiley += 1
        actor.x = (actor.tilex << wl_def.tile_shift) + wl_def.tile_global // 2
        actor.y = (actor.tiley << wl_def.tile_shift) + wl_def.tile_global // 2
    let index = game.actor_count
    game.actors[(usize)index] = actor
    game.actorat[wl_def.cell(actor.tilex, actor.tiley)] = 1000 + (u16)index
    game.actor_count += 1
    game.killtotal += 1

pub func spawn_dead_guard(game: Game*, x: i64, y: i64):
    if game.actor_count >= wl_def.max_actors:
        return
    var actor = Actor(x = (x << wl_def.tile_shift) + wl_def.tile_global // 2,
        y = (y << wl_def.tile_shift) + wl_def.tile_global // 2,
        tilex = x, tiley = y, class = wl_def.class_dead, shapenum = wl_def.spr_grd_dead,
        flags = wl_def.fl_nonmark | wl_def.fl_nevermark, active = true, dir = wl_def.nodir,
        state = &s_grddie4)
    wl_state.new_state(&actor, &s_grddie4)
    actor.flags = wl_def.fl_nonmark | wl_def.fl_nevermark
    game.actors[(usize)game.actor_count] = actor
    game.actor_count += 1

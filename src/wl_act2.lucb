var states_ready: bool = false

func set(st: State*, rotate: i64, shape: i64, tics: i64, think: (func(Game*, Actor*) -> unit)?,
         action: (func(Game*, Actor*) -> unit)?, next: State*):
    st.rotate = rotate
    st.shapenum = shape
    st.tictime = tics
    st.think = think
    st.action = action
    st.next = next

## WL_ACT2.C static initialisers. next pointers are filled here because Base has no
## mutually-recursive global aggregate initialisers.
pub func init_states():
    if states_ready:
        return
    states_ready = true
    set(&s_grdstand, 1, wl_def.spr_grd_s1, 0, t_stand, none, &s_grdstand)
